  m_Script: {fileID: 11500000, guid: a26e0ffbf532d224b9ce4d954374097c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  poemTexts:
  - "I\u2019ll be with you\r\nIn another ten, in our flat in Sunrise.\r\nWe dance
    to Red Summer, eye to foot and \r\nwith hips entwined, we rock between the candles,"
  - "lit with hopes of bright forevers. \r\nOf us in every place we shed a tear,
    of every kiss\nr lips held young and soft in spot\r"
  - 'for a second more, you look away, the candle melts.

    I tell you Fear not.'
  textIndex: 0
