  m_Script: {fileID: 11500000, guid: a26e0ffbf532d224b9ce4d954374097c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  poemTexts:
  - "I\u2019ll be with you\r\nnext Tuesday, as you wait at the station\r\nyour peony
    dress and hair split with bows"
  - 'Eyes in haste like tailing ink blots

    at hunt for dawns still to be forever
    ours.

    I tell you Fear not.'
  textIndex: 0
